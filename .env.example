# Copy to .env and edit. Never commit a real token.
#
# Hugging Face Read token with "read gated repos" scope. Required only for
# downloading weights (the downloader service) and only if a step needs it.
HF_TOKEN=

# Where weights and outputs live on the host.
# MODELS_HOST_DIR maps to /models in the container, and the distilled weights
# must therefore sit at <MODELS_HOST_DIR>/diffusion_models/...
MODELS_HOST_DIR=./models/ltx-2.5
OUTPUT_HOST_DIR=./output

# Conditioning audio for the a2vid (audio-to-video) pipeline. Mounted read-only at
# /audio; pass clips as --audio /audio/<name>.wav.
AUDIO_HOST_DIR=./audio

# Generation defaults (overridable per run).
HEIGHT=768
WIDTH=1280
NUM_FRAMES=121
QUANTIZATION=fp8-cast
OFFLOAD=cpu

# Optional: extra weight sets for the downloader.
INCLUDE_DFR=0
INCLUDE_DURATION_HEAD=0
# +~51 GiB: full dev transformer and the distilled LoRA, required by a2vid.
INCLUDE_A2VID=0

# Optional build-time knobs.
LTX_REF=main
